{
  "name": "csv2ofx",
  "version": "0.0.12",
  "private": false,
  "description": "Convert CSV files to OFX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rylorin/csv2ofx.git"
  },
  "license": "MIT",
  "author": "Ronan-Yann Lorin <ryl@free.fr>",
  "bin": {
    "csv2ofx": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf build",
    "dev": "ts-node-dev --project tsconfig.json src/index",
    "lint": "prettier --check ./src && eslint ./src",
    "prepublishOnly": "yarn build",
    "qc": "yarn lint && yarn type-check",
    "start": "NODE_ENV=production node build/index.js",
    "test": "yarn qc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "config": "^5.0.0",
    "csv-parse": "^7.0.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.5",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
