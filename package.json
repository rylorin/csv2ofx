{
  "name": "csv2ofx",
  "version": "0.1.0",
  "private": false,
  "description": "Convert CSV files to OFX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rylorin/csv2ofx.git"
  },
  "license": "MIT",
  "author": "Ronan-Yann Lorin <ryl@free.fr>",
  "bin": {
    "csv2ofx": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "lint": "prettier --check ./src && eslint ./src",
    "prepublishOnly": "yarn build",
    "qc": "yarn lint && yarn type-check && yarn test",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.ts": "yarn lint",
    "*.{ts,json,md}": "prettier --check"
  },
  "dependencies": {
    "config": "^5.0.1",
    "csv-parse": "^7.0.3",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "^6.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.23.3"
  }
}
