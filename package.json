{
  "name": "csv2ofx",
  "version": "0.0.15",
  "private": false,
  "description": "Convert CSV files to OFX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rylorin/csv2ofx.git"
  },
  "license": "MIT",
  "author": "Ronan-Yann Lorin <ryl@free.fr>",
  "bin": {
    "csv2ofx": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "lint": "prettier --check ./src && eslint ./src",
    "prepublishOnly": "yarn build",
    "qc": "yarn lint && yarn type-check",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "yarn qc",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.ts": "yarn lint",
    "*.{ts,json,md}": "prettier --check"
  },
  "dependencies": {
    "config": "^5.0.1",
    "csv-parse": "^7.0.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.1",
    "@typescript/typescript6": "^6.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.5",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
