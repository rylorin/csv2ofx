{
  "compilerOptions": {
    /* ===========================================================================
     * TS 7 Migration Notes
     * =====================
     * When upgrading to TypeScript 7 (Go port), apply these changes:
     *
     * 1. module: "Node16" → "NodeNext"
     * 2. moduleResolution: "node16" → "nodenext"
     * 3. Remove "isolatedModules", replace with "verbatimModuleSyntax": true
     * 4. "erasableSyntaxOnly" is the default in TS 7 (can remove explicit setting)
     * 5. "esModuleInterop" may need review (verbatimModuleSyntax changes behavior)
     * 6. "outDir" is no longer needed — tsc is type-checker only, use tsup/esbuild
     *    for JS emit. Update build script: "build": "tsup"
     * 7. All imports must use "import type" for type-only imports
     * 8. "forceConsistentCasingInFileNames" is the default in TS 7
     * =========================================================================== */

    /* Language and Environment */
    "target": "ES2022" /* ES2022 enables useDefineForClassFields and modern syntax expected by TS 7. */,
    "lib": ["ES2025"],

    "rootDir": "./src",
    /* Modules */
    "module": "NodeNext" /* TS 7: change to "NodeNext" */,
    "moduleResolution": "nodenext" /* TS 7: change to "nodenext" */,
    "resolveJsonModule": true,

    /* Emit */
    "outDir": "dist" /* TS 7: remove — tsc no longer emits JS, use tsup instead */,

    /* Interop Constraints */
    "isolatedModules": true /* TS 7: replace with "verbatimModuleSyntax": true */,
    "erasableSyntaxOnly": true /* TS 7: default behavior, can remove explicit setting */,
    "esModuleInterop": true /* TS 7: review — may conflict with verbatimModuleSyntax */,
    "forceConsistentCasingInFileNames": true /* TS 7: default behavior, can remove */,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": ["src"]
}
